# --------------------------------------------------------------------------- #
# RouterX environment (Python/FastAPI server + Python Jinja2 UI)
# --------------------------------------------------------------------------- #

# 1) Database — SQLAlchemy. Prisma-style values are accepted and normalized:
#      file:./db/custom.db                -> SQLite (fine locally; EPHEMERAL on Render)
#      file:/abs/path/custom.db           -> SQLite (absolute)
#      postgres://user:pass@host/db       -> PostgreSQL (Neon/Supabase/Aiven…)
#      pgbouncer/connection_limit params are stripped automatically.
#
#  ⚠ ON RENDER ALWAYS SET A POSTGRES URL (free at neon.tech). The SQLite
#    fallback lives inside the ephemeral container, so every deploy (git push)
#    wipes providers, models, keys, routes and configs. With Postgres the
#    tables are created automatically on first boot and your data persists
#    forever — boot is additive-only and NEVER deletes existing rows.
DATABASE_URL=file:./db/custom.db
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# 2) Public base URL — every externally visible base_url (meta endpoint,
#    README examples, client snippets) points at the hosted domain. When unset,
#    the server uses the incoming request origin, which on Render is your
#    hosted domain automatically.
# PUBLIC_BASE_URL=https://novarouter.onrender.com

# 3) Server port — Render assigns PORT dynamically. Locally the server defaults
#    to 3000. Never hardcode a platform port.
# PORT=10000

# 4) CORS — origins allowed to call the API from browsers. Comma-separated.
# CORS_ALLOW_ORIGINS=*

# 5) RouterX Free engine sidecar (managed automatically — no need to set):
#    spawned by main.py on 127.0.0.1:3099 using bun or node when available.
# NOVA_ENGINE_PORT=3099
#    Set to 1 to keep the sidecar off (e.g. a preview proxy that only knows the
#    app port). The gateway then serves configured upstreams only.
# NOVA_ENGINE_DISABLED=0

# 6) Long-running / streaming upstream tuning.
#    Max seconds of silence between upstream bytes before the call fails.
# NOVA_UPSTREAM_READ_TIMEOUT=600
#    Seconds between SSE keep-alive comments while an upstream is silent.
# NOVA_SSE_HEARTBEAT=10
#    Max auto stand-in providers appended to a fallback chain.
# NOVA_AUTO_STANDINS=6
#    Upstream connect timeout, in seconds.
# NOVA_CONNECT_TIMEOUT=5
#    Read timeout for non-streaming upstream calls, in seconds.
# NOVA_NONSTREAM_READ_TIMEOUT=300
#    Exchange read timeout for trading quote/positions/balances, in seconds.
# NOVA_TRADING_TIMEOUT=10

# 7) Catalogue seed. On boot, seed the curated provider/model catalogue
#    (providers start disabled; existing rows are never touched). Set "off"
#    to skip it. SystemConfig key: seed_registry_models.
# NOVA_SEED_REGISTRY=on

# --------------------------------------------------------------------------- #
# Gateway control: auth, limits, cache, sessions (all opt-in — the defaults
# below keep routing identical to a deployment that never set them)
# --------------------------------------------------------------------------- #

# 8) Client-key auth (nova/auth.py). Anonymous gateway requests are allowed
#    while no enabled ClientKey exists; set this to force a key regardless.
#    Once one enabled key exists, anonymous requests are refused anyway.
# NOVA_REQUIRE_API_KEY=0

# 9) Upstream rate limits (nova/ratelimit.py). Per-(provider, model) windows.
#    0 = unlimited (default). Per-provider overrides live in the dashboard /
#    the SystemConfig `rate_limits` knob and win over these env defaults.
# NOVA_DEFAULT_RPM=0
# NOVA_DEFAULT_TPM=0
# NOVA_DEFAULT_RPD=0
# NOVA_DEFAULT_TPD=0

# 10) Upstream key cooldowns, in seconds, after a failure with no Retry-After.
# NOVA_KEY_COOLDOWN_429=60
# NOVA_KEY_COOLDOWN_5XX=30
# NOVA_KEY_COOLDOWN_401=300
# NOVA_KEY_COOLDOWN_MAX=900

# 11) Response cache (nova/cache.py) — OFF by default. When on, stores only
#     non-streaming 200 completions with no tool calls; `x-nova-no-cache: 1`
#     bypasses it. SystemConfig knob: response_cache.
# NOVA_RESPONSE_CACHE=off
# NOVA_RESPONSE_CACHE_TTL=300
# NOVA_RESPONSE_CACHE_MAX=256

# 12) Sticky sessions (nova/session.py). How long a conversation stays pinned
#     to the model that served it, when the client sends `x-nova-session`.
# NOVA_SESSION_TTL=1800

# --------------------------------------------------------------------------- #
# Terminal — these live in terminal/config.py and belong to the terminal
# feature (it can be hosted on its own). See terminal/README.md.
# --------------------------------------------------------------------------- #
# Host the terminal separately (unset = in-process)
# NOVA_TERMINAL_URL=http://terminal-host:3100
# Shared secret for X-Nova-Terminal-Token (set on BOTH hosts before exposing)
# NOVA_TERMINAL_TOKEN=
# The terminal's own port (default 3100)
# NOVA_TERMINAL_PORT=3100
# Where shells start (default /app/build)
# NOVA_BUILD_ROOT=/app/build
# Agentbox agent (standalone terminal only)
# NOVA_AGENTBOX_BASE_URL=
# NOVA_AGENTBOX_API_KEY=
# NOVA_AGENTBOX_MODEL=
# Max plan steps and per-step timeout for Agentbox
# NOVA_AGENTBOX_MAX_STEPS=8
# NOVA_AGENTBOX_STEP_TIMEOUT=120
# Where Agentbox keeps its provider registry (0600, beside the workspace)
# NOVA_AGENTBOX_PROVIDER_FILE=
